{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["frontend/js/**/*.js", "frontend/css/**/*.css"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "parser": {
      "jsxEverywhere": false
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "globals": [
      "AppState",
      "Api",
      "MapView",
      "ObjectsManager",
      "EventPanel",
      "TrafficSignals",
      "ScenarioTemplates",
      "PropCatalog",
      "LaneGraph",
      "Dropdown",
      "SpecialBuildings",
      "AerialMap",
      "ScenarioGenerator",
      "EventTimeline",
      "BgTraffic",
      "Toast",
      "Confirm",
      "UndoStack",
      "UIUtils",
      "ScenarioRules",
      "Simulate",
      "ScenarioIO"
    ]
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noRedundantUseStrict": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  }
}
